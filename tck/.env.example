# The variables of tck/docker-compose.yml (section 10.7 of docs/architecture/implementation_plan.md).
# Copy the file to tck/.env, which git ignores, and replace every value <...> by a local test value.
# The image names and versions are the verified values of tck/README.md.

TCK_IMAGE_CONTROL_PLANE=tractusx/edc-controlplane-postgresql-hashicorp-vault:0.13.0
TCK_IMAGE_DATA_PLANE=tractusx/edc-dataplane-hashicorp-vault:0.13.0
TCK_IMAGE_POSTGRES=postgres:17
TCK_IMAGE_CONNECTOR_POSTGRES=postgres:18.0
TCK_IMAGE_VAULT=hashicorp/vault:1.16.1
TCK_IMAGE_IDENTITY=tractusx/ssi-dim-wallet-stub:0.1.0
TCK_IMAGE_BPN_DID=tractusx/bdrs-server-memory:0.6.0
TCK_IMAGE_DTR=tractusx/sldt-digital-twin-registry:0.13.0
# The image of the one run that writes the secrets of the connectors and the BPN-DID mappings.
TCK_IMAGE_NODE=node:24

# Local test values: 32 characters or more where the server checks the length (section 9.6).
TCK_VAULT_TOKEN=<a local test token of the secret stores>
TCK_CONNECTOR_DATABASE_PASSWORD=<a local test password of the connector databases>
TCK_SERVER_DATABASE_PASSWORD=<a local test password of the superuser of the server databases>
TCK_APP_ROLE_PASSWORD=<a local test password of the role refserver_app>
TCK_EDC_MANAGEMENT_API_KEY=<a local test key of 32 characters or more of the management APIs>
TCK_BDRS_MANAGEMENT_API_KEY=<a local test key of the management API of the BPN-DID Resolution Service>
TCK_OPERATOR_TOKEN_SECRET=<a local test key of 32 characters or more of the operator tokens>
TCK_DATA_PLANE_KEY_1=<a local test key of 32 characters or more of the data plane of participant 1>
TCK_DATA_PLANE_KEY_2=<a local test key of 32 characters or more of the data plane of participant 2>
TCK_DATA_PLANE_KEY_3=<a local test key of 32 characters or more of the data plane of participant 3>
